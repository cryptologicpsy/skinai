ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=8787

# MongoDB (raw driver, no ORM).
# - Running the backend directly on the host (npm run dev, no Docker):
#     MONGODB_URI=mongodb://127.0.0.1:27018   (matches the mongo service's
#     published port in the repo root's docker-compose.yml)
# - Running inside Docker Compose (either docker-compose.yml or
#   docker-compose.prod.yml): both already override this to
#   mongodb://mongo:27017 (the internal service name) via `environment:`,
#   so this value only matters for the host-direct case above.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=skinai

# Long random string — used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Must match the URL the frontend is served from (CORS + cookies)
FRONTEND_ORIGIN=http://localhost:5173

# How long a user's uploaded photo is kept before automatic deletion.
# Score/metrics from the scan are kept regardless — only the photo file is removed.
PHOTO_RETENTION_DAYS=7

# How often the retention sweep runs, in ms (default: hourly)
RETENTION_SWEEP_INTERVAL_MS=3600000
